# StockQuant 环境变量模板
# 复制为 .env 文件并填入实际值
# =====================================================================
# AI/LLM 配置
# =====================================================================
# OpenAI / 兼容 API
OPENAI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
AI_LIGHTWEIGHT_MODEL=gpt-4o-mini
# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_BASE=

# 本地 LLM 配置（NFR008 Tick 级 <200ms，可选）
# 启用后可在 Settings 页面选择 local/* 或 ollama/* 模型
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BACKEND=ollama
LOCAL_LLM_MODEL=qwen2.5-7b-instruct
LOCAL_LLM_BASE_URL=http://localhost:11434

# =====================================================================
# 进化 LLM 配置
# =====================================================================
# 策略进化专用模型（独立于主 AI 模型）
EVO_LLM_PROVIDER=openai
EVO_LLM_MODEL=gpt-4o
EVO_LLM_API_KEY=
EVO_LLM_API_BASE=
EVO_LLM_TEMPERATURE=0.5
EVO_LLM_MAX_TOKENS=4096
EVO_LLM_RETRY=3
EVO_ANTHROPIC_MODEL=claude-3-opus

# =====================================================================
# 数据库配置
# =====================================================================
DATABASE_URL=postgresql://stockquant:stockquant_secret@localhost:5432/stockquant
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# =====================================================================
# Redis 配置
# =====================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_SOCKET_TIMEOUT=5

# =====================================================================
# Kafka 配置
# =====================================================================
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=stockquant-consumers
KAFKA_SIGNAL_TOPIC=stock-signal
KAFKA_ALERT_TOPIC=stock-alert
KAFKA_SECURITY_PROTOCOL=plaintext

# =====================================================================
# 数据源配置
# =====================================================================
DATA_PROVIDER_SOURCE=baostock
DATA_PROVIDER_API_KEY=
DATA_PROVIDER_API_URL=
TUSHARE_TOKEN=
AKSHARE_PROXY=
JQDATA_MOBILE=
JQDATA_PASSWORD=

# =====================================================================
# 交易/券商配置
# =====================================================================
TRADING_BROKER=paper
TRADING_ADMIN_TOKEN=MyTradingAdminSecret2026
QMT_PATH=
QMT_ACCOUNT=
QMT_PASSWORD=
XTP_USER=
XTP_PASSWORD=
XTP_APP_ID=
CTP_USER=
CTP_PASSWORD=
CTP_BROKER_ID=

# =====================================================================
# 回测/风控配置
# =====================================================================
BACKTEST_DEFAULT_CASH=1000000
RISK_MAX_POSITION_PCT=0.3
RISK_MAX_DAILY_LOSS_PCT=0.05
RISK_MAX_DRAWDOWN_PCT=0.15

# =====================================================================
# 通知配置
# =====================================================================
DINGTALK_WEBHOOK_URL=
WECHAT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
PUSHPLUS_TOKEN=
FEISHU_WEBHOOK_URL=

# =====================================================================
# 信号配置
# =====================================================================
SIGNAL_DEDUP_COOLDOWN_SEC=14400
SIGNAL_DEDUP_DB_CHECK_PENDING=true
SIGNAL_DEDUP_AUDIT_REJECTED=true

# =====================================================================
# 调度/决策配置
# =====================================================================
DECISION_MODE=manual
MONITOR_SCAN_INTERVAL=30
ALERT_THRESHOLD=3.0

# =====================================================================
# 缓存/JWT/限流配置
# =====================================================================
CACHE_TTL_HOURS=24
CACHE_MAX_SIZE_MB=1024
JWT_SECRET_KEY=stockquant-dev-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
SQ_ENCRYPTION_KEY=
RATE_LIMIT=100 per minute

# =====================================================================
# 系统配置
# =====================================================================
LOG_LEVEL=INFO
CACHE_DIR=~/.stockquant/data
LOG_DIR=./log
HOST=0.0.0.0
PORT=8000
DEBUG=false
WORKERS=4

# =====================================================================
# 功能开关
# =====================================================================
SIGNAL_DEDUP_ENABLED=false
SIMULATOR_FORCE_RUN=true
